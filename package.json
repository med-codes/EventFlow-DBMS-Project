{
  "name": "eventflow",
  "version": "1.0.0",
  "description": "EventFlow - Event Ticket Booking and Management System (College DBMS Project)",
  "scripts": {
    "dev": "npm --prefix server run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "test": "npm --prefix server test",
    "db:migrate": "psql -U postgres -h localhost -p 5432 -d eventflow_db -f database/migrations/001_initial_schema.sql -f database/migrations/002_triggers_and_functions.sql -f database/migrations/003_views.sql",
    "db:seed": "psql -U postgres -h localhost -p 5432 -d eventflow_db -f database/seeds/001_seed_data.sql"
  },
  "keywords": [
    "dbms",
    "postgresql",
    "ticket-booking",
    "full-stack",
    "express",
    "react"
  ],
  "author": "EventFlow Student Developer",
  "license": "ISC"
}
