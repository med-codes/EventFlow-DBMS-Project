# EventFlow Server Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=eventflow_db
TEST_DB_NAME=eventflow_test_db

# Security & Sessions
JWT_SECRET=replace_with_a_secure_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# Business Rules Configuration
SEAT_LOCK_DURATION_MINUTES=10
CANCELLATION_REFUND_PERCENTAGE=80

# Client Application URL (CORS)
CORS_ORIGIN=http://localhost:5173
